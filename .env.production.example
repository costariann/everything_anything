# Application Environment
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@db:5432/everythinganything_prod
CORS_ORIGIN=https://your-production-domain.com
NEXT_PUBLIC_API_URL=https://your-production-domain.com/api/v1

# JWT Secrets (Must be unique 32+ character secrets)
JWT_ACCESS_SECRET=production_secure_jwt_access_secret_key_change_me
JWT_REFRESH_SECRET=production_secure_jwt_refresh_secret_key_change_me

# Firebase Storage
FIREBASE_STORAGE_BUCKET=your_production_storage_bucket.appspot.com
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Initial Admin Account Configuration
ADMIN_EMAIL=admin@your-production-domain.com
ADMIN_PASSWORD=ProductionSuperSecureAdminPassword!
ADMIN_NAME=Store Administrator
ADMIN_PHONE=+1234567890
