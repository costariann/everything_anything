# Application Environment
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/everythinganything_dev
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# JWT Secrets (Generate secure random 32+ character strings for production)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_me
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_me

# Firebase Storage
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Initial Admin Account Seed Configuration
ADMIN_EMAIL=admin@everythinganything.com
ADMIN_PASSWORD=YourSecureAdminPassword123!
ADMIN_NAME=Store Administrator
ADMIN_PHONE=+1234567890

# Optional Demo Customer Seed Configuration
DEMO_CUSTOMER_EMAIL=customer@example.com
DEMO_CUSTOMER_PASSWORD=CustomerPassword123!
